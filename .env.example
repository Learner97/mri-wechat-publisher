# Copy to .env and set values locally. Never paste the secret into chat or commit .env.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional. Defaults to ./.mri-wechat-publisher in the active workspace.
MRI_WECHAT_DATA_DIR=

# Optional. Defaults to ./.env in the active workspace.
MRI_WECHAT_ENV_FILE=

# Optional contact address used for NCBI/OpenAlex polite-pool requests.
NCBI_EMAIL=

