{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/mri-wechat-publisher/article.schema.json",
  "title": "MRI WeChat source-grounded article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "publication_mode",
    "title",
    "author",
    "digest",
    "source",
    "sections",
    "figures",
    "references",
    "evidence_map"
  ],
  "$defs": {
    "image_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["original_path", "original_sha256", "source_locator"],
      "properties": {
        "original_path": {"type": "string", "minLength": 1},
        "original_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "source_locator": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4, 5, 6, 7, 8]},
    "article_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "publication_mode": {"const": "draft_only"},
    "title": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^[^|\\s](?:[^|\\r\\n]*[^|\\s])? \\| [^|\\s](?:[^|\\r\\n]*[^|\\s])?$"},
    "author": {"type": "string", "minLength": 1, "maxLength": 64},
    "digest": {"type": "string", "minLength": 1, "maxLength": 120},
    "content_source_url": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_id",
        "evidence_level",
        "fulltext_verified",
        "source_manifest"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "doi": {"type": "string"},
        "pmid": {"type": "string"},
        "url": {"type": "string"},
        "journal": {"type": "string"},
        "published_at": {"type": "string"},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "version_status": {
          "enum": [
            "VERSION_OF_RECORD",
            "PROOF",
            "ACCEPTED_MANUSCRIPT",
            "PREPRINT",
            "OTHER_VERIFIED"
          ]
        },
        "evidence_level": {"enum": ["FULLTEXT", "TEST_FIXTURE"]},
        "fulltext_verified": {"type": "boolean"},
        "source_manifest": {"type": "string", "minLength": 1}
      }
    },
    "cover": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "alt", "source_note"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "image_provenance": {"$ref": "#/$defs/image_provenance"},
        "mobile_display": {"$ref": "#/properties/figures/items/properties/mobile_display"},
        "path": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 1},
        "source_note": {"type": "string", "minLength": 1}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "blocks"],
        "properties": {
          "id": {"type": "string"},
          "heading": {"type": "string"},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"enum": ["paragraph", "subheading", "callout", "list", "image"]},
                "text": {"type": "string"},
                "items": {"type": "array", "items": {"type": "string"}},
                "ordered": {"type": "boolean"},
                "asset_id": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "path", "alt", "caption", "source", "license_note"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "figure_id": {"type": "string", "minLength": 1},
          "image_provenance": {"$ref": "#/$defs/image_provenance"},
          "path": {"type": "string", "minLength": 1},
          "alt": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "license_note": {"type": "string", "minLength": 1},
          "mobile_display": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy"],
            "properties": {
              "strategy": {"enum": ["native", "cropped", "split_panel", "selected_panels"]},
              "source_figure_id": {"type": "string", "minLength": 1},
              "panel_label": {"type": "string", "minLength": 1},
              "review_note": {"type": "string", "minLength": 1},
              "crop_review": {"type": "string", "minLength": 1},
              "crop_reason": {"enum": ["dense_composite", "too_tall", "cover_ratio"]},
              "crop_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
              "annotations_preserved": {"type": "boolean"}
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "strategy": {"enum": ["cropped", "split_panel", "selected_panels"]}
                  },
                  "required": ["strategy"]
                },
                "then": {"required": ["source_figure_id"]}
              }
            ]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "verified"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "citation": {"type": "string", "minLength": 1},
          "doi": {"type": "string"},
          "url": {"type": "string"},
          "verified": {"type": "boolean"}
        }
      }
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "source_locator", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "claim_type": {
            "enum": [
              "direct_result",
              "author_interpretation",
              "editorial_explanation",
              "editorial_extension"
            ]
          },
          "status": {"enum": ["verified", "blocked", "needs_review"]},
          "risk_tags": {"type": "array", "uniqueItems": true, "items": {"enum": ["subtype_stage", "crosssection_change", "association_causality", "mr_assumptions", "interaction_inference", "validation_scope", "metric_interpretation", "spatial_to_individual", "metric_definition", "sample_denominator"]}},
          "article_locations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/(?:sections/\\d+/blocks/\\d+/(?:text|items/\\d+)|title|digest)$"}},
          "essential_result": {"type": "boolean"}
        }
      }
    },
    "method_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "name",
          "section_heading",
          "purpose",
          "data",
          "processing_steps",
          "statistics",
          "source_locators",
          "status"
        ],
        "properties": {
          "method_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "section_heading": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "importance": {"enum": ["core", "supporting", "routine"]},
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "sample": {"type": "string"},
              "source": {"type": "string"},
              "modality": {"type": "string"},
              "groups": {"type": "string"},
              "analysis_unit": {"type": "string"},
              "dimensions": {"type": "string"}
            }
          },
          "processing_steps": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "statistics": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_locators": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "unreported_details": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "critical_missing_details": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "status": {"const": "verified"}
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "need_open_comment": {"enum": [0, 1]},
        "only_fans_can_comment": {"enum": [0, 1]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 8}, "source": {"properties": {"evidence_level": {"const": "FULLTEXT"}}}},
        "required": ["schema_version", "source"]
      },
      "then": {
        "properties": {
          "cover": {"required": ["figure_id", "image_provenance", "mobile_display"]},
          "figures": {"items": {"required": ["image_provenance"]}}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 1}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "sections": {
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要解读"}}},
              {"properties": {"id": {"const": "design"}, "heading": {"const": "研究设计与数据"}}},
              {"properties": {"id": {"const": "method"}, "heading": {"const": "核心方法解析"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "关键结果与证据链"}}},
              {"properties": {"id": {"const": "implications"}, "heading": {"const": "方法启示与总结"}}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 2}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
              {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
              {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
              {"properties": {"id": {"const": "discussion"}, "heading": {"const": "讨论与总结"}}}
            ]
          },
          "figures": {
            "items": {"required": ["figure_id"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 3}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
              {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
              {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
              {"properties": {"id": {"const": "discussion"}, "heading": {"const": "讨论"}}},
              {"properties": {"id": {"const": "summary"}, "heading": {"const": "总结"}}}
            ]
          },
          "figures": {
            "items": {"required": ["figure_id"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 4}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["method_map"],
        "properties": {
          "method_map": {
            "items": {"required": ["outputs"]}
          },
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
              {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
              {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
              {"properties": {"id": {"const": "discussion"}, "heading": {"const": "讨论"}}},
              {"properties": {"id": {"const": "summary"}, "heading": {"const": "总结"}}}
            ]
          },
          "figures": {
            "items": {"required": ["figure_id"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 5}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["method_map"],
        "properties": {
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
              {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
              {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
              {"properties": {"id": {"const": "discussion"}, "heading": {"const": "讨论"}}},
              {"properties": {"id": {"const": "summary"}, "heading": {"const": "总结"}}}
            ]
          },
          "figures": {
            "items": {"required": ["figure_id"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          },
          "method_map": {
            "items": {
              "required": ["importance"],
              "not": {"required": ["unreported_details"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 6}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["method_map"],
        "properties": {
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "anyOf": [
              {
                "minItems": 6,
                "maxItems": 6,
                "prefixItems": [
                  {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
                  {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
                  {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
                  {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
                  {"properties": {"id": {"const": "result_interpretation"}, "heading": {"const": "结果解读"}}},
                  {"properties": {"id": {"const": "closing"}, "heading": {"const": "结语"}}}
                ]
              },
              {
                "minItems": 7,
                "maxItems": 7,
                "prefixItems": [
                  {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
                  {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
                  {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
                  {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
                  {"properties": {"id": {"const": "result_interpretation"}, "heading": {"const": "结果解读"}}},
                  {"properties": {"id": {"const": "method_insights"}, "heading": {"const": "方法启示"}}},
                  {"properties": {"id": {"const": "closing"}, "heading": {"const": "结语"}}}
                ]
              }
            ]
          },
          "figures": {
            "items": {"required": ["figure_id"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          },
          "method_map": {
            "items": {
              "required": ["importance"],
              "not": {"required": ["unreported_details"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 7}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["method_map"],
        "properties": {
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              {"properties": {"id": {"const": "abstract"}, "heading": {"const": "摘要"}}},
              {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
              {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
              {"properties": {"id": {"const": "result_interpretation"}, "heading": {"const": "结果解读"}}},
              {"properties": {"id": {"const": "closing"}, "heading": {"const": "结语"}}}
            ]
          },
          "figures": {
            "items": {"required": ["figure_id"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          },
          "method_map": {
            "items": {
              "required": ["importance"],
              "not": {"required": ["unreported_details"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 8}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["method_map"],
        "properties": {
          "source": {
            "required": ["journal", "published_at", "authors", "version_status"],
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "pmid": {"type": "string", "minLength": 1},
              "journal": {"type": "string", "minLength": 1},
              "published_at": {"type": "string", "minLength": 1}
            },
            "anyOf": [
              {"required": ["doi"]},
              {"required": ["pmid"]}
            ]
          },
          "sections": {
            "minItems": 6,
            "maxItems": 6,
            "prefixItems": [
              {"properties": {"id": {"const": "overview"}, "heading": {"const": "研究速览"}}},
              {"properties": {"id": {"const": "introduction"}, "heading": {"const": "引言"}}},
              {"properties": {"id": {"const": "methods"}, "heading": {"const": "方法"}}},
              {"properties": {"id": {"const": "results"}, "heading": {"const": "结果"}}},
              {"properties": {"id": {"const": "result_interpretation"}, "heading": {"const": "结果解读"}}},
              {"properties": {"id": {"const": "closing"}, "heading": {"const": "结语"}}}
            ]
          },
          "figures": {
            "items": {"required": ["figure_id", "mobile_display"]}
          },
          "evidence_map": {
            "items": {"required": ["claim_type"]}
          },
          "method_map": {
            "items": {
              "required": ["importance"],
              "not": {"required": ["unreported_details"]}
            }
          }
        }
      }
    }
  ]
}
