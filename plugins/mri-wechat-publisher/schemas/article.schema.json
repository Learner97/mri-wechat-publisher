{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/mri-wechat-publisher/article.schema.json",
  "title": "MRI WeChat hybrid article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "publication_mode",
    "title",
    "author",
    "digest",
    "source",
    "sections",
    "figures",
    "references",
    "evidence_map"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "article_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "publication_mode": {"const": "draft_only"},
    "title": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^[^|\\s](?:[^|\\r\\n]*[^|\\s])? \\| [^|\\s](?:[^|\\r\\n]{0,18}[^|\\s])?$"},
    "author": {"type": "string", "minLength": 1, "maxLength": 64},
    "digest": {"type": "string", "minLength": 1, "maxLength": 120},
    "content_source_url": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_id",
        "evidence_level",
        "fulltext_verified",
        "source_manifest"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "doi": {"type": "string"},
        "url": {"type": "string"},
        "journal": {"type": "string"},
        "published_at": {"type": "string"},
        "evidence_level": {"enum": ["FULLTEXT", "TEST_FIXTURE"]},
        "fulltext_verified": {"type": "boolean"},
        "source_manifest": {"type": "string", "minLength": 1}
      }
    },
    "cover": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "alt", "source_note"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 1},
        "source_note": {"type": "string", "minLength": 1}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "blocks"],
        "properties": {
          "id": {"type": "string"},
          "heading": {"type": "string"},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"enum": ["paragraph", "subheading", "callout", "list", "image"]},
                "text": {"type": "string"},
                "items": {"type": "array", "items": {"type": "string"}},
                "ordered": {"type": "boolean"},
                "asset_id": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "path", "alt", "caption", "source", "license_note"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "alt": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "license_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "verified"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "citation": {"type": "string", "minLength": 1},
          "doi": {"type": "string"},
          "url": {"type": "string"},
          "verified": {"type": "boolean"}
        }
      }
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "source_locator", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "blocked"]}
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "need_open_comment": {"enum": [0, 1]},
        "only_fans_can_comment": {"enum": [0, 1]}
      }
    }
  }
}
