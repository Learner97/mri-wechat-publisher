    "displayName": "MRI \u6587\u732e\u516c\u4f17\u53f7\u52a9\u624b",
    "shortDescription": "\u68c0\u67e5\u5168\u6587\u53ef\u7528\u6027\uff0c\u518d\u628a MRI \u6587\u732e\u4e0e\u65b9\u6cd5\u89e3\u6790\u8f6c\u4e3a\u5f85\u5ba1\u6838\u7684\u516c\u4f17\u53f7\u8349\u7a3f\u3002",
    "longDescription": "\u9762\u5411 MRI\u3001\u8ba4\u77e5\u795e\u7ecf\u79d1\u5b66\u53ca\u76f8\u5173\u533b\u5b66\u548c\u751f\u7269\u5b66\u9886\u57df\uff0c\u5728\u63a8\u8350\u9636\u6bb5\u4ec5\u901a\u8fc7\u5143\u6570\u636e\u68c0\u67e5\u5168\u6587\u4e0e\u8865\u5145\u6750\u6599\u53ef\u7528\u6027\uff0c\u9009\u6587\u540e\u518d\u6839\u636e\u5408\u6cd5\u516c\u5f00\u6765\u6e90\u6216\u7528\u6237\u4e0a\u4f20\u6587\u4ef6\u5efa\u7acb\u6765\u6e90\u6e05\u5355\u3002\u53ea\u6709\u901a\u8fc7\u8bba\u6587\u8eab\u4efd\u548c\u5168\u6587\u8bc1\u636e\u95e8\u63a7\u540e\uff0c\u624d\u751f\u6210\u6587\u732e\u4e0e\u65b9\u6cd5\u878d\u5408\u6587\u7ae0\u3001\u6392\u7248\u5e76\u4fdd\u5b58\u516c\u4f17\u53f7\u8349\u7a3f\u3002\u63d2\u4ef6\u9ed8\u8ba4\u7981\u6b62\u81ea\u52a8\u53d1\u8868\u3002",
    "developerName": "Solel",
    "category": "Productivity",
    "websiteURL": "https://github.com/Learner97/mri-wechat-publisher",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "defaultPrompt": [
      "\u4e3a\u4e94\u7bc7 MRI \u5019\u9009\u8bba\u6587\u68c0\u67e5\u516c\u5f00\u5168\u6587\u4e0e\u8865\u5145\u6750\u6599\u53ef\u7528\u6027\uff0c\u4f46\u4e0d\u4e0b\u8f7d\u6b63\u6587\u3002",
      "\u6574\u5408\u5df2\u6838\u9a8c\u7814\u7a76\u6750\u6599\uff0c\u5148\u4e3a\u6bcf\u7bc7\u8bba\u6587\u627e\u5230\u5408\u9002\u7684\u7070\u6846\u5165\u53e3\uff0c\u518d\u51b3\u5b9a\u4f7f\u7528\u9648\u8ff0\u3001\u53cd\u5dee\u3001\u89c2\u5bdf\u3001\u5f00\u653e\u95ee\u9898\u6216\u81ea\u95ee\u81ea\u7b54\uff1b\u95ee\u53e5\u4e0d\u662f\u9ed8\u8ba4\uff0c\u6279\u91cf\u6587\u7ae0\u9700\u68c0\u67e5\u53e5\u5f0f\u540c\u6784\u3002\u7814\u7a76\u901f\u89c8\u4ea4\u4ee3\u600e\u4e48\u505a\u548c\u53d1\u73b0\u4ec0\u4e48\uff0c\u7ed3\u8bed\u4e0d\u5f3a\u5236\u9644\u52a0\u65b9\u6cd5\u542f\u793a\u3002",
      "\u68c0\u67e5\u76f8\u5173\u3001\u7a7a\u95f4\u5173\u8054\u548c\u57fa\u56e0\u5bcc\u96c6\u7ed3\u679c\u7684\u7ed3\u8bba\u5f3a\u5ea6\uff0c\u964d\u4f4e\u6a21\u677f\u5316 AI \u8868\u8fbe\uff0c\u5e76\u4f18\u5148\u9009\u62e9\u79fb\u52a8\u7aef\u53ef\u8bfb\u7684\u6838\u5fc3\u7ed3\u679c\u56fe\u3002",
      "\u8d28\u68c0\u5e76\u4fdd\u5b58\u5230\u5fae\u4fe1\u516c\u4f17\u53f7\u8349\u7a3f\u7bb1\uff0c\u4f46\u4e0d\u8981\u53d1\u8868\u3002"
    ]
